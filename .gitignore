# ---------------------------------------------------------------
# MAI byte del firmware Elektron nel repo (vedi LEGAL.md).
# Questa e' la prima linea di difesa; la seconda e' l'hook
# tools/hooks/pre-commit (attivalo con: git config core.hooksPath tools/hooks).
# ---------------------------------------------------------------
*.syx
*.SYX
*.bin
*.raw
*.elf
*.img

# Firmware stock scaricato da elektron.se: resta solo in locale
firmware/*
!firmware/README.md

# Output di unpack/build
unpacked/
build/out/
out/

# Dipendenze esterne clonate/compilate in locale (tools/unpack/setup_eft.sh)
third_party/

# Ghidra: il progetto contiene il firmware disassemblato -> mai nel repo
*.gpr
*.rep/
ghidra/

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/

# Node
node_modules/

# OS / editor
.DS_Store
Thumbs.db
.vscode/

# Manuali e datasheet di terzi (copyright NXP/Elektron): solo in locale
refs/
*.pdf

# Note di lavoro locali (journal, brief, strumenti di studio): mai pubblicate
local/

# registrazioni delle misure (tools/measure)
rec/

# Generated Windows package artifacts (the source manifest and MIT helper source remain tracked)
tools/max/windows_builder/resources/*.exe
tools/max/windows_builder/build/
tools/max/windows_builder/dist/
tools/max/windows_builder/*.spec

# Maintained source specification; generated specs remain ignored.
!tools/max/windows_builder/windows.spec
